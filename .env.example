# -----------------------------------------------------------------------------
# Banco principal (PostgreSQL)
#  - Produção: Neon pela Vercel (Storage → Neon, região São Paulo) cria esta
#    variável (conexão com pool) e a DATABASE_URL_UNPOOLED (direta, usada nas migrations).
#  - Local: rode `npm run db:local` e cole aqui a URL postgres:// que ele mostrar.
# -----------------------------------------------------------------------------
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Só local: banco "sombra" do `prisma dev` (porta TCP + 1), usado pelo `prisma migrate dev`.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Duração da sessão de login, em dias.
SESSION_TTL_DAYS=7

# Usados pelo `npm run db:seed` (primeiro administrador). Na Vercel, defina
# SEED_ADMIN_EMAIL/SEED_ADMIN_PASSWORD nas Environment Variables: o build cria o administrador.
SEED_ADMIN_EMAIL="admin@engemase.com.br"
SEED_ADMIN_PASSWORD=""

# Notificações push (Web Push). Gere o par com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@engemase.com.br"

# Segredo da rota /api/cron/alarms (avaliador de alarmes). A Vercel envia
# "Authorization: Bearer <CRON_SECRET>" nos cron jobs automaticamente.
CRON_SECRET=""

# Cache compartilhado (Upstash Redis pela Vercel: Storage → Upstash → Redis).
# Opcional no desenvolvimento; recomendado em produção. A integração cria KV_REST_API_URL/TOKEN.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Agendador Upstash QStash (opcional): chaves de assinatura para validar as chamadas.
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# Endereço público do sistema, usado nos links de senha e convite enviados por e-mail.
# Na Vercel, sem isto usa o domínio de produção do projeto.
APP_URL=""
# E-mail pelo Resend (opcional). Sem isto, "Esqueci minha senha" fica desativado e os
# convites mostram um link para o administrador repassar.
RESEND_API_KEY=""
EMAIL_FROM="Monitor de Energia <nao-responda@seudominio.com.br>"

# Telegram (opcional): alarmes pelo bot. Crie com o @BotFather (/newbot) e cole o token.
TELEGRAM_BOT_TOKEN=""
